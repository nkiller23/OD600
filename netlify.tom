[build]
  publish = "."

# Redirect HTTP -> HTTPS for all paths
[[redirects]]
  from = "http:///*"
  to = "https://:splat"
  status = 301
  force = true

# Add HSTS header (no preload here; aggiungi preload solo se sai come gestire la registrazione)
[[headers]]
  for = "/*"
  [headers.values]
    Strict-Transport-Security = "max-age=63072000; includeSubDomains"
